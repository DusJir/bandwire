{
  "name": "bandwire",
  "version": "1.0.0",
  "description": "Signal flow diagram tool for live musicians",
  "main": "electron/main.js",
  "author": {
    "name": "Barney Estrada",
    "url": "bandwire.bastardizer.cz",
    "email": "barney.estrada@bastardizer.cz"
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux",
    "build:pwa": "BUILD_TARGET=pwa vite build",
    "dev:pwa": "BUILD_TARGET=pwa vite",
    "gen-icons": "node scripts/generate-icon-manifest.js",
    "build:electron": "vite build"
  },
  "build": {
    "appId": "com.bandwire.app",
    "productName": "BandWire",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icons",
        "to": "icons",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "icon": "build",
      "category": "AudioVideo",
      "description": "Signal flow diagram tool for live musicians",
      "mimeTypes": ["application/x-sflow"],
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BandWire"
    },
    "fileAssociations": [
      {
        "ext": "sflow",
        "name": "BandWire Project",
        "description": "BandWire signal flow project",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "react-i18next": "^16.6.6",
    "reactflow": "^11.11.4",
    "vite-plugin-pwa": "^1.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^29.4.0",
    "electron-builder": "^26.8.1",
    "i18next": "^25.10.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.1",
    "wait-on": "^9.0.4"
  }
}
