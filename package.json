{
  "name": "bandwire",
  "version": "1.2.2",
  "description": "Signal flow diagram tool for live musicians",
  "homepage": "https://dev.grinware.cz",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux",
    "build:pwa": "cross-env BUILD_TARGET=pwa vite build",
    "dev:pwa": "cross-env BUILD_TARGET=pwa vite",
    "gen-icons": "node scripts/generate-icon-manifest.js",
    "build:electron": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": {
    "name": "Barney Estrada",
    "email": "barney.estrada@bastardizer.cz",
    "url": "https://dev.grinware.cz"
  },
  "build": {
    "appId": "com.bandwire.app",
    "productName": "BandWire",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "description": "Signal flow diagram tool for live musicians",
      "mimeTypes": [
        "application/x-sflow"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BandWire",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "sflow",
        "name": "BandWire Project",
        "description": "BandWire signal flow project",
        "role": "Editor"
      }
    ],
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "DusJir",
      "repo": "bandwire"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "html-to-image": "^1.11.11",
    "i18next": "^25.10.9",
    "react-i18next": "^16.6.6",
    "reactflow": "^11.11.4",
    "vite-plugin-pwa": "^1.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.1",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  }
}